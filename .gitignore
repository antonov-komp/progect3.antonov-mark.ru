# Logs (global and app-local)
/logs/
/logs-apps/
/app/logs/
/app/config/

# Embed field settings (runtime data)
/data/embed-settings/*.json

# Sensitive app settings
/app/settings.php
/app/settings.json

# Outgoing webhook local config
/outgoing-webhook/config.local.php

# Outgoing webhook runtime files
/outgoing-webhook/logs/
/outgoing-webhook/queue/
/outgoing-webhook/state/

# Frontend dependencies
/frontend/node_modules/
/frontend/.npm-cache/
/tmp/

# SQLite database
/outgoing-webhook/database/events.db
